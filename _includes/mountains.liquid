{% comment %}
  Decorative parallax mountain range pinned to the bottom of the viewport.
  Purely ornamental, so it is hidden from assistive technology. All of the
  shapes, colours and motion live in _sass/_mountains.scss.
{% endcomment %}
<div class="mountains" aria-hidden="true">
  <div class="mountain-layer mountain-layer--1"></div>
  <div class="mountain-layer mountain-layer--2"></div>
  <div class="mountain-layer mountain-layer--3"></div>
  <div class="mountain-layer mountain-layer--4"></div>
</div>
